#!/bin/sh
# The repository is public: refuse a commit when the offline tests fail, among them the
# checks that no real IP or hostname from a finding is in the tree.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -m unittest discover -s tests -q || {
  echo "pre-commit: tests failed, commit stopped (findings must never be committed)" >&2
  exit 1
}
